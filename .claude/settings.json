{
  "permissions": {
    "allow": [
      "Bash(curl -s -o /dev/null -w \"/ → %{http_code}\\\\n\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"/kategorien → %{http_code}\\\\n\" http://localhost:3000/kategorien)",
      "Bash(curl -s -o /dev/null -w \"/tool-stacks → %{http_code}\\\\n\" http://localhost:3000/tool-stacks)",
      "Bash(curl -s -o /dev/null -w \"/vergleichen → %{http_code}\\\\n\" http://localhost:3000/vergleichen)",
      "Bash(curl -s -o /dev/null -w \"/ratgeber → %{http_code}\\\\n\" http://localhost:3000/ratgeber)",
      "Bash(cmd /c \"netstat -ano | findstr :3001 | findstr LISTENING\")",
      "Bash(npx next *)",
      "Bash(npm run *)",
      "Bash(npx prisma generate)",
      "Bash(git tag *)",
      "Read(//tmp/**)",
      "PowerShell(Get-Process -Name \"node\" -ErrorAction SilentlyContinue)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-settings.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "npm run lint --silent 1>&2" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/session-reminder.js" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/zwischenstand-laden.js" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/zwischenstand-pruefen.js" }
        ]
      }
    ]
  }
}