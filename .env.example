# Connect to Supabase via connection pooling (Vercel / Produktion)
DATABASE_URL=

# Direct connection — wird für Prisma Migrations verwendet
DIRECT_URL=

# Supabase öffentliche URL und Anon Key (sicher für Client-Code)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key — NUR server-seitig, niemals im Client
SUPABASE_SERVICE_ROLE_KEY=

# Error Monitoring (leer lassen für lokale Entwicklung)
SENTRY_DSN=

# DSGVO: Salt für IP-Hashing im Affiliate-Tracking.
# Ohne diesen Wert wird kein IP-Hash gespeichert (Privacy-by-default).
# Beliebiger langer zufälliger String, z.B.: openssl rand -hex 32
IP_HASH_SALT=
